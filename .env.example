HOST=127.0.0.1
PORT=3000
DATA_DIR=.signalloop
# Required for a non-loopback HOST. Use a long random value; do not commit it.
ACCESS_TOKEN=
# Optional: explicit opt-in to send transcript/copy context to Google.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional local automatic transcription; install scripts/requirements.txt first.
ENABLE_WHISPER=0
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
MAX_UPLOAD_MB=512
